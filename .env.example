# ============================================================
# EKIA - Enterprise Knowledge Intelligence Assistant
# Environment Variables Example
# Copy this file to .env and fill in the values.
# Never commit .env to source control.
# ============================================================

# --- Application ---
APP_ENV=development
SECRET_KEY=your-secret-key-min-32-chars-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://ekia_user:ekia_password@localhost:5432/ekia_db
SYNC_DATABASE_URL=postgresql://ekia_user:ekia_password@localhost:5432/ekia_db

# --- Google Gemini API ---
GOOGLE_API_KEY=your-google-gemini-api-key-here

# --- Embedding Model ---
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768

# --- LLM Model ---
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# --- RAG Configuration ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.7

# --- File Upload ---
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,txt,docx

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=20

# --- Logging ---
LOG_LEVEL=INFO

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=EKIA

# --- Docker Compose (Postgres) ---
POSTGRES_USER=ekia_user
POSTGRES_PASSWORD=ekia_password
POSTGRES_DB=ekia_db
